<!DOCTYPE html>
<html>
  <head>
    <title>Link-in-bio</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>

    <style>
      body {
        padding-top: 40px;
        padding-bottom: 40px;
        background-color: #232946;
        display: flex;
        justify-content: center;
      }

      .banner {
        display: flex;
        justify-content: center;
      }

      .banner-image {
        width: 150px;
        height: 150px;
        object-fit: cover;
        border-radius: 150px;
        border: 2px solid #fffffe;
      }

      .thumbnail {
        width: 48px;
        height: 48px;
        border-radius: 48px;
        object-fit: cover;
      }

    .name {
        color: #fffffe;
        display: flex;
        justify-content: center;
        font-size: 20px;
      }

      .social-icons a {
        color: #eebbc3;
        text-decoration: none;
        display: flex;
        justify-content: space-around;
      }

      .link {
        background-color: #b8c1ec;
        display: flex;
        align-items: center;
        padding: 5px;
        border-radius: 20px;
        border: 3px solid #fffffe;
      }

    .link a {
        color: #232946;
        text-decoration: none;
        text-align: center;
        flex-grow: 1;
      }

      .items {
        display: flex;
        flex-direction: column;
        gap: 30px;
        max-width: 650px;
        flex-grow: 1;
      }
    </style>
  </head>

  <body>
    <%= yield %>
  </body>
</html>
